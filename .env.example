# Local Node dev. Copy to .env in the repo root (read by pnpm dev, db:migrate and db:seed).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prospector
# 32+ chars. Keys opt-out hashes: changing it later orphans every existing opt-out.
# Generate with: openssl rand -hex 32
SUPPRESSION_SECRET=
ENVIRONMENT=development
# access (Cloudflare Access JWT, production) | basic | none (development only)
AUTH_MODE=none
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# Optional JSON overriding packages/core/src/config.ts defaults, e.g.
# APP_CONFIG={"dedupe":{"fuzzyThreshold":0.7}}
